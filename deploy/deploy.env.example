# Скопируйте в deploy/deploy.env на сервере (файл в .gitignore).
# Переменные ниже переопределяют значения по умолчанию в deploy.sh.

APP_DIR=/var/www/corporate.admsr.ru
DOMAIN=corporate.admsr.ru
# если портал открывают как newcorp — для health-check:
# HEALTH_HOST=newcorp.admsr.ru
DATA_DIR=/var/lib/corporate-app
BACKUP_KEEP=7

# Health-check (через nginx на localhost; HTTP редиректит на HTTPS)
HEALTH_URL=https://127.0.0.1/api/health.php
HEALTH_HOST=corporate.admsr.ru
# HEALTH_INSECURE=1  # уже подразумевается для 127.0.0.1 (curl -k)

# systemd
SERVICE_NAME=php8.3-fpm
GO_SERVICE_NAME=corporate-go-api

# Go API: при отсутствии go скачать toolchain (1) или полагаться на готовый bin/api (0)
GO_AUTO_INSTALL=1
GO_VERSION=1.22.10
# GO_SYNC_NGINX=1   # копировать deploy/nginx-corporate.admsr.ru.conf → sites-available и reload
# SKIP_GO=0

# PostgreSQL (для бэкапа перед деплоем)
PGHOST=localhost
PGPORT=5432
PGDATABASE=corporate_portal
PGUSER=myuser
# PGPASSWORD=secret

# npm | pnpm (в репозитории — package-lock.json → npm ci по умолчанию)
PACKAGE_MANAGER=npm
