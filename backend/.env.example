# На corporate-testing порт 8080 занят nginx site "api" — ставьте 8081
HTTP_ADDR=127.0.0.1:8081

DB_HOST=localhost
DB_PORT=5432
DB_NAME=corporate_portal
DB_USER=myuser
DB_PASS=CHANGE_ME

# Session TTL hours (must match PHP AUTH_SESSION_TTL_HOURS = 24)
AUTH_SESSION_TTL_HOURS=24

# ASU sync (used when local user_info row is missing)
ASU_URL=https://172.17.30.42/asu_lookup.php
ASU_HOST=asu.admsr.ru
ASU_SECRET=asu_corporate_sync_key

# Картинки + birthdays_xlsx: на testing — public проекта
UPLOAD_DIR=/var/www/corporate.admsr.ru/public
